---
import { people, schools } from '../data/philosophers';
import {
  sorted, rowY, bars, leaders, links, spines, schoolHome, ticks, eraMarks,
  height, yOf, SVG_W, ROW_H, fmtYear, fmtSpan, barX, anchorOf,
} from '../lib/layout';

// Minimap: periods as bands, people as dots at their birth year (lane = lifespan lane)
const pct = (y: number) => ((y / height) * 100).toFixed(2);
const eraBands = eraMarks.map((e, i) => ({
  name: e.name,
  top: pct(e.y),
  h: pct((eraMarks[i + 1]?.y ?? height) - e.y),
}));

const homeOf = new Map([...schoolHome.entries()].map(([s, p]) => [p, s]));

// Compact data for the client: per-person info + the highlight geometry.
const data = {
  people: Object.fromEntries(
    people.map((p) => [p.id, {
      name: p.name, span: fmtSpan(p), active: fmtYear(anchorOf(p)), note: p.note, school: p.school,
      studentOf: p.studentOf ?? [], influence: p.influence ?? [],
      students: people.filter((q) => q.studentOf?.includes(p.id)).map((q) => q.id),
      influenced: people.filter((q) => q.influence?.includes(p.id)).map((q) => q.id),
    }]),
  ),
  schools: Object.fromEntries(
    Object.entries(schools).map(([id, s]) => [id, {
      name: s.name, philosophy: s.philosophy, home: schoolHome.get(id as any),
      founded: 'founded' in s ? fmtYear(s.founded) : null,
      members: sorted.filter((p) => p.school === id).map((p) => p.id),
    }]),
  ),
  links, leaders: Object.fromEntries(leaders.map((l) => [l.id, l.d])),
  bars: Object.fromEntries(bars.map((b) => [b.id, b])),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Greek Philosophers — Timeline</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <header>
      <h1>Greek Philosophers</h1>
      <p class="legend">
        <span><i class="k-bar"></i>lifespan (tick = when active)</span>
        <span><svg width="26" height="8"><path d="M0,4H26" class="k-student" /></svg>student of</span>
        <span><svg width="26" height="8"><path d="M0,4H26" class="k-influence" /></svg>main influence (on select)</span>
        <span class="hint">Hover or tap a person.</span>
      </p>
    </header>

    <main id="tl" style={`height:${height}px`}>
      {ticks.map((t) => (
        <div class="tick" style={`top:${yOf(t)}px`}><span>{t === 1 ? '1 CE' : fmtYear(t)}</span></div>
      ))}
      {eraMarks.map((e) => (
        <div class="era" style={`top:${e.y}px`}><span>{e.name}</span></div>
      ))}

      <svg id="lines" viewBox={`0 0 ${SVG_W} ${height}`} preserveAspectRatio="none" aria-hidden="true">
        <g id="base">
          {leaders.map((l) => <path class="leader" d={l.d} />)}
          {bars.map((b) => <path class="bar" d={`M${b.x},${b.y1}V${b.y2}`} />)}
          {bars.map((b) => <path class="atick" d={`M${b.x - 3},${b.ya}H${b.x + 3}`} />)}
          {links.filter((l) => l.type === 'student').map((l) => <path class="student" d={l.d} />)}
        </g>
        <g id="hl"></g>
      </svg>

      {spines.map((s) => (
        <div class="spine" data-school={s.id} style={`top:${s.top}px;height:${s.bottom - s.top}px`}></div>
      ))}

      {sorted.map((p) => {
        const founds = homeOf.get(p.id);
        const s = founds && schools[founds];
        return (
          <div class="row" id={p.id} data-id={p.id} style={`top:${rowY.get(p.id)}px;height:${ROW_H}px`}>
            <span class="dot"></span>
            <div class="person">
              <div class="l1"><b>{p.name}</b> <span class="dates">{fmtSpan(p)}</span></div>
              <div class="note">{p.note}</div>
            </div>
            <div class="school">
              {s ? (
                <>
                  <div class="sname">{s.name}{'founded' in s && <span class="founded"> · {fmtYear(s.founded)}</span>}</div>
                  <div class="sphil">{s.philosophy}</div>
                </>
              ) : p.school ? (
                <div class="member">{schools[p.school].name}</div>
              ) : null}
            </div>
          </div>
        );
      })}
    </main>

    <aside id="panel" hidden></aside>

    <nav id="mini" aria-label="Timeline overview">
      {eraBands.map((b) => (
        <div class="band" style={`top:${b.top}%;height:${b.h}%`} title={b.name}><span>{b.name}</span></div>
      ))}
      {sorted.map((p) => (
        <i class="mdot" data-id={p.id} title={p.name}
          style={`top:${pct(yOf(anchorOf(p)))}%;left:${14 + ((barX.get(p.id)! - 6) / 7) * 2.2}px`}></i>
      ))}
      <div id="view"></div>
    </nav>

    <script is:inline define:vars={{ data }}>
      const tl = document.getElementById('tl');
      const hl = document.getElementById('hl');
      const panel = document.getElementById('panel');
      const mini = document.getElementById('mini');
      const view = document.getElementById('view');
      const mdots = Object.fromEntries([...mini.querySelectorAll('.mdot')].map((d) => [d.dataset.id, d]));
      const rows = Object.fromEntries([...document.querySelectorAll('.row')].map((r) => [r.dataset.id, r]));
      const spines = Object.fromEntries([...document.querySelectorAll('.spine')].map((s) => [s.dataset.school, s]));
      const linksBy = {};
      for (const l of data.links) (linksBy[l.from] ??= []).push(l), (linksBy[l.to] ??= []).push(l);

      let marked = [];
      let current = null;

      function focus(id) {
        if (id === current) return;
        current = id;
        for (const el of marked) el.classList.remove('on', 'mate', 'rel');
        marked = [];
        if (!id) { tl.classList.remove('focusing'); hl.innerHTML = ''; return; }

        const p = data.people[id];
        const related = new Set([id]);
        let svg = '';
        for (const l of linksBy[id] ?? []) {
          related.add(l.from); related.add(l.to);
          svg += `<path class="${l.type}" d="${l.d}"/>`;
        }
        const b = data.bars[id];
        svg += `<path class="leader" d="${data.leaders[id]}"/><path class="bar" d="M${b.x},${b.y1}V${b.y2}"/><path class="atick" d="M${b.x - 4},${b.ya}H${b.x + 4}"/>`;
        hl.innerHTML = svg;

        for (const r of related) {
          const cls = r === id ? 'on' : 'rel';
          rows[r].classList.add(cls); mdots[r].classList.add(cls);
          marked.push(rows[r], mdots[r]);
        }
        if (p.school) {
          for (const m of data.schools[p.school].members) { rows[m].classList.add('mate'); marked.push(rows[m]); }
          const home = data.schools[p.school].home;
          if (home) { rows[home].classList.add('mate'); marked.push(rows[home]); }
          if (spines[p.school]) { spines[p.school].classList.add('on'); marked.push(spines[p.school]); }
        }
        tl.classList.add('focusing');
      }

      const link = (ids) => ids.map((i) => `<a href="#${i}">${data.people[i].name}</a>`).join(', ');
      function showPanel(id) {
        if (!id) { panel.hidden = true; return; }
        const p = data.people[id];
        const s = p.school && data.schools[p.school];
        const lines = [
          s && (s.home === id
            ? `<dt>Founded</dt><dd>${s.name}${s.founded ? ` (${s.founded})` : ''}<br><small>${s.philosophy}</small></dd>`
            : `<dt>School</dt><dd>${s.name}<br><small>${s.philosophy}</small></dd>`),
          !p.school && `<dt>School</dt><dd>None</dd>`,
          p.studentOf.length && `<dt>Student of</dt><dd>${link(p.studentOf)}</dd>`,
          p.students.length && `<dt>Teacher of</dt><dd>${link(p.students)}</dd>`,
          p.influence.length && `<dt>Influenced by</dt><dd>${link(p.influence)}</dd>`,
          p.influenced.length && `<dt>Influenced</dt><dd>${link(p.influenced)}</dd>`,
        ].filter(Boolean).join('');
        panel.innerHTML = `<button class="x" aria-label="Close">×</button><h2>${p.name}</h2><div class="dates">${p.span} · active c. ${p.active}</div><p>${p.note}</p><dl>${lines}</dl>`;
        panel.hidden = false;
      }

      let pinned = null;
      function pin(id) {
        pinned = id;
        focus(id);
        showPanel(id);
      }

      tl.addEventListener('mouseover', (e) => {
        if (pinned) return;
        const r = e.target.closest('.row');
        focus(r ? r.dataset.id : null);
      });
      tl.addEventListener('mouseleave', () => !pinned && focus(null));
      tl.addEventListener('click', (e) => {
        const r = e.target.closest('.row');
        if (!r) return pin(null);
        pin(pinned === r.dataset.id ? null : r.dataset.id);
      });
      panel.addEventListener('click', (e) => {
        if (e.target.closest('.x')) return pin(null);
        const a = e.target.closest('a');
        if (!a) return;
        e.preventDefault();
        const id = a.getAttribute('href').slice(1);
        rows[id].scrollIntoView({ behavior: 'smooth', block: 'center' });
        pin(id);
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && pin(null));

      // Minimap: viewport box follows scroll; click or drag to jump; click a dot to select.
      let tlTop = 0, tlH = 1, ticking = false;
      const clamp = (v) => Math.max(0, Math.min(1, v));
      function measure() { tlTop = tl.getBoundingClientRect().top + scrollY; tlH = tl.offsetHeight; syncView(); }
      function syncView() {
        ticking = false;
        const a = clamp((scrollY - tlTop) / tlH);
        const b = clamp((scrollY + innerHeight - tlTop) / tlH);
        view.style.top = a * 100 + '%';
        view.style.height = (b - a) * 100 + '%';
      }
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(syncView); } }, { passive: true });
      addEventListener('resize', measure);
      measure();

      const jumpTo = (e) => {
        const r = mini.getBoundingClientRect();
        const f = clamp((e.clientY - r.top) / r.height);
        scrollTo({ top: tlTop + f * tlH - innerHeight / 2 });
      };
      let dragging = false;
      mini.addEventListener('pointerdown', (e) => {
        const dot = e.target.closest('.mdot');
        if (dot) {
          rows[dot.dataset.id].scrollIntoView({ block: 'center' });
          return pin(dot.dataset.id);
        }
        dragging = true;
        mini.setPointerCapture(e.pointerId);
        jumpTo(e);
      });
      mini.addEventListener('pointermove', (e) => dragging && jumpTo(e));
      mini.addEventListener('pointerup', () => (dragging = false));
      mini.addEventListener('pointercancel', () => (dragging = false));
    </script>

    <style is:global>
      :root {
        --fg: #1d1d1b; --muted: #7a776f; --faint: #e4e0d7; --bg: #faf9f6; --accent: #2f5d8a;
        --tick-w: 64px; --svg-w: 200px; --school-w: 250px;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.35 ui-serif, Georgia, serif; }
      header { max-width: 1000px; margin: 0 auto; padding: 32px 16px 24px; }
      h1 { font-size: 28px; margin: 0 0 8px; font-weight: 600; }
      .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); font: 13px system-ui, sans-serif; margin: 0; align-items: center; }
      .legend svg, .k-bar { vertical-align: middle; margin-right: 5px; }
      .k-bar { display: inline-block; width: 3px; height: 14px; background: #c9c4b8; }
      .k-student { stroke: #8a867d; stroke-width: 1.4; }
      .k-influence { stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 4 3; }

      #tl { position: relative; max-width: 1000px; margin: 0 auto 120px; }

      .tick, .era { position: absolute; left: 0; right: 0; height: 0; pointer-events: none; }
      .tick { border-top: 1px solid #efece5; }
      .tick span { position: absolute; left: 16px; top: -8px; font: 11px system-ui, sans-serif; color: var(--muted); background: var(--bg); padding-right: 4px; }
      .era { border-top: 1px solid #c8d5e2; width: calc(var(--tick-w) + var(--svg-w)); }
      .era span { position: absolute; left: 16px; top: 2px; font: 600 10px system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); background: var(--bg); padding-right: 4px; white-space: nowrap; }

      #lines { position: absolute; top: 0; left: var(--tick-w); width: var(--svg-w); height: 100%; overflow: visible; pointer-events: none; }
      #lines path { fill: none; vector-effect: non-scaling-stroke; }
      .bar { stroke: #cfcabd; stroke-width: 3; stroke-linecap: round; }
      .leader { stroke: #e3dfd5; stroke-width: 1; }
      .atick { stroke: #a9a49a; stroke-width: 1.5; }
      #hl .atick { stroke-width: 2; }
      .student { stroke: #9a968c; stroke-width: 1.2; }
      .influence { stroke-dasharray: 4 3; }
      .focusing #base { opacity: .18; }
      #hl path { stroke: var(--accent); }
      #hl .bar { stroke-width: 3; }
      #hl .student { stroke-width: 2; }
      #hl .influence { stroke-width: 1.5; }
      #hl .leader { stroke-width: 1; opacity: .6; }

      .row { position: absolute; left: calc(var(--tick-w) + var(--svg-w)); right: 16px; display: grid; grid-template-columns: 1fr var(--school-w); gap: 16px; padding-left: 14px; cursor: pointer; }
      .dot { position: absolute; left: -5px; top: 7px; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--fg); }
      .person, .school { min-width: 0; }
      .l1, .note, .sphil, .member, .sname { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .l1 b { font-size: 16px; font-weight: 600; }
      .dates, .note, .sphil, .member, .founded { font: 12.5px system-ui, sans-serif; color: var(--muted); }
      .dates { margin-left: 4px; }
      .sname { font-weight: 600; color: var(--accent); }
      .member { display: none; padding-left: 10px; }
      .spine { position: absolute; right: calc(16px + var(--school-w) + 2px); width: 2px; background: var(--accent); opacity: .5; display: none; pointer-events: none; }

      .focusing .row { opacity: .3; }
      .focusing .row.mate { opacity: .6; }
      .focusing .row.rel { opacity: .8; }
      .focusing .row.on { opacity: 1; }
      .row.rel .dot { border-color: var(--accent); }
      .row.on .dot { border-color: var(--accent); background: var(--accent); }
      .row.mate .member, .spine.on { display: block; }

      #panel { position: fixed; right: 16px; bottom: 16px; width: 300px; max-height: 70vh; overflow: auto; background: #fff; border: 1px solid var(--faint); box-shadow: 0 6px 24px rgba(0,0,0,.08); padding: 14px 16px; font: 13px/1.45 system-ui, sans-serif; z-index: 10; }
      #panel h2 { font: 600 19px ui-serif, Georgia, serif; margin: 0; }
      #panel p { margin: 6px 0 10px; }
      #panel dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; }
      #panel dt { color: var(--muted); }
      #panel dd { margin: 0; }
      #panel small { color: var(--muted); }
      #panel a { color: var(--accent); text-decoration: none; }
      #panel .x { position: absolute; top: 6px; right: 8px; border: 0; background: none; font-size: 20px; color: var(--muted); cursor: pointer; }

      #mini { position: fixed; top: 16px; bottom: 16px; left: 12px; width: 48px; background: #f3f1ec; border: 1px solid var(--faint); border-radius: 4px; cursor: pointer; touch-action: none; user-select: none; z-index: 5; }
      .band { position: absolute; left: 0; right: 0; border-top: 1px solid #c8d5e2; }
      .band:nth-of-type(even) { background: #eae7df; }
      .band span { position: absolute; left: 1px; top: 4px; writing-mode: vertical-rl; font: 600 8.5px system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); white-space: nowrap; pointer-events: none; }
      .mdot { position: absolute; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: #8f8b81; }
      .mdot.rel { background: var(--accent); opacity: .55; }
      .mdot.on { background: var(--accent); width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; z-index: 1; }
      #view { position: absolute; left: -1px; right: -1px; border: 1.5px solid var(--accent); background: rgba(47, 93, 138, .08); border-radius: 3px; pointer-events: none; }
      @media (max-width: 1160px) { body { padding-left: 64px; } }

      @media (max-width: 700px) {
        body { padding-left: 30px; }
        #mini { left: 4px; width: 24px; top: 8px; bottom: 8px; }
        .band span { display: none; }
        .mdot { left: 4px !important; }
        :root { --tick-w: 0px; --svg-w: 110px; --school-w: 0px; }
        header { padding: 20px 14px 16px; }
        .tick span, .era span { left: 2px; font-size: 9.5px; }
        .school, .spine { display: none !important; }
        .row { grid-template-columns: 1fr; right: 8px; }
        .dates { display: block; margin: 0; }
        .l1 { white-space: normal; line-height: 1.15; }
        .note { display: none; }
        #panel { left: 34px; right: 8px; bottom: 8px; width: auto; max-height: 45vh; }
      }
    </style>
  </body>
</html>
