---
import { people, schools } from '../data/philosophers';
import {
  sorted, rowY, spans, schoolHome, ticks, eraMarks,
  height, yOf, SVG_W, ROW_H, fmtYear, fmtSpan, anchorOf, miniCol,
  GRAPH_X0, MAX_COMPARE, branches, merges, branchDots, branchLeaders, branchHL, schoolTags, schoolHL,
} from '../lib/layout';

// Minimap: periods as bands, people as dots at their active year
const pct = (y: number) => ((y / height) * 100).toFixed(2);
const eraBands = eraMarks.map((e, i) => ({
  name: e.name,
  top: pct(e.y),
  h: pct((eraMarks[i + 1]?.y ?? height) - e.y),
}));

// Compact data for the client: per-person info and the highlight for each person.
const data = {
  people: Object.fromEntries(
    people.map((p) => [p.id, {
      name: p.name, span: fmtSpan(p), active: fmtYear(anchorOf(p)), from: fmtYear(p.born), to: fmtYear(p.died), note: p.note, school: p.school,
      studentOf: p.studentOf ?? [], influence: p.influence ?? [],
      students: people.filter((q) => q.studentOf?.includes(p.id)).map((q) => q.id),
      influenced: people.filter((q) => q.influence?.includes(p.id)).map((q) => q.id),
    }]),
  ),
  schools: Object.fromEntries(
    Object.entries(schools).map(([id, s]) => [id, {
      name: s.name, philosophy: s.philosophy, note: s.note, home: schoolHome.get(id as any),
      founded: 'founded' in s ? fmtYear(s.founded) : null,
      members: sorted.filter((p) => p.school === id).map((p) => p.id),
    }]),
  ),
  spans: Object.fromEntries(spans.map((b) => [b.id, b])),
  maxCompare: MAX_COMPARE,
  branchHL,
  schoolHL,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Greek Philosophers — Timeline</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <header>
      <h1>Greek Philosophers</h1>
      <p class="legend">
        <span><svg width="26" height="8"><path d="M0,4H26" class="k-branch" /></svg>school (forks from the founder's teacher)</span>
        <span><svg width="26" height="8"><path d="M0,4H26" class="k-merge" /></svg>teacher or influence</span>
        <span><svg width="26" height="8"><path d="M0,4H26" class="k-life" /></svg>lifespan (on select)</span>
        <span class="hint">Hover or tap a person. Shift+click, or Select, to compare several.</span>
      </p>
    </header>

    <main id="tl" style={`height:${height}px;--graph-f:${GRAPH_X0 / SVG_W}`}>
      {ticks.map((t) => (
        <div class="tick" style={`top:${yOf(t)}px`}><span>{t === 1 ? '1 CE' : fmtYear(t)}</span></div>
      ))}
      {eraMarks.map((e) => (
        <div class="era" style={`top:${e.y}px`}><span>{e.name}</span></div>
      ))}

      <svg id="lines" viewBox={`0 0 ${SVG_W} ${height}`} preserveAspectRatio="none" aria-hidden="true">
        <g id="branch">
          {/* Layers: graph lines, then the highlight's lines, then leader lines, then dots. */}
          <g>
            {branches.map((b) => <path class="branch" d={b.d} />)}
            {merges.map((m) => <path class="merge" d={m.d} />)}
          </g>
          <g>
            <path id="bh-life" class="gl life p-low a-lifespan" />
            <path id="bh-after" class="gl after p-normal a-accent" />
            <path id="bh-along" class="gl along p-high a-accent" />
            <path id="bh-influence" class="gl infl p-high a-accent" />
            <path id="bh-path" class="gl trail p-high a-accent" />
            {Array.from({ length: MAX_COMPARE }, (_, i) => <path class={`gl trail p-high a-accent s${i}`} data-slot={i} />)}
          </g>
          <g>{branchLeaders.map((l) => <path class="leader p-subtle a-neutral" data-id={l.id} d={l.d} />)}</g>
          <g>
            {branchDots.map((t) => (
              <g class="bd p-max a-neutral" data-id={t.id}>
                <path class="bdot" d={`M${t.x},${t.y}h0`} />
                <path class="hole" d={`M${t.x},${t.y}h0`} />
              </g>
            ))}
          </g>
        </g>
      </svg>
      {schoolTags.map((t) => (
        <button type="button" class="btag" data-school={t.id} style={`top:${t.y}px;--xf:${t.xf}`}>{t.name}</button>
      ))}
      {['from', 'to'].map((end) => (
        <div class="spanlabel" id={`span-${end}`} hidden></div>
      ))}

      {sorted.map((p) => (
        <div class:list={['row', p.priority === 'grand' && 'grand', !p.priority && 'minor']} id={p.id} data-id={p.id} style={`top:${rowY.get(p.id)}px;height:${ROW_H}px`}>
          <span class="dot"></span>
          <div class="l1"><b>{p.name}</b></div>
          <div class="note">{p.note}</div>
        </div>
      ))}
    </main>

    <aside id="panel" hidden></aside>
    <div id="tools">
      <button id="all" type="button" hidden>Select all</button>
      <button id="select" type="button" aria-pressed="false">Select</button>
    </div>

    <nav id="mini" aria-label="Timeline overview">
      {eraBands.map((b) => (
        <div class="band" style={`top:${b.top}%;height:${b.h}%`} title={b.name}><span>{b.name}</span></div>
      ))}
      {sorted.map((p) => (
        <i class="mdot" data-id={p.id} title={p.name}
          style={`top:${pct(yOf(anchorOf(p)))}%;left:${14 + miniCol.get(p.id)! * 4}px`}></i>
      ))}
      <div id="view"></div>
    </nav>

    <script is:inline define:vars={{ data }}>
      const tl = document.getElementById('tl');
      const panel = document.getElementById('panel');
      const mini = document.getElementById('mini');
      const view = document.getElementById('view');
      const mdots = Object.fromEntries([...mini.querySelectorAll('.mdot')].map((d) => [d.dataset.id, d]));
      const rows = Object.fromEntries([...document.querySelectorAll('.row')].map((r) => [r.dataset.id, r]));
      const tags = Object.fromEntries([...document.querySelectorAll('.btag')].map((t) => [t.dataset.school, t]));
      const allIds = Object.keys(data.spans);
      const slots = Array.from({ length: data.maxCompare }, (_, i) => `s${i}`);

      let marked = [];
      const mark = (el, ...cls) => { el.classList.add(...cls); marked.push(el); };

      // Selection: an ordered list of ids. One = pinned person (info card). Several = compare:
      // each one's path in their own colour (up to MAX_COMPARE). No info card for several.
      let selected = [];
      let selectMode = false;
      let hovered = null;
      let school = null; // a focused school (its tag was clicked), instead of people

      function render() {
        for (const el of marked) el.classList.remove('on', 'mate', 'rel', ...slots);
        marked = [];
        const ids = school ? [] : selected.length ? selected : hovered ? [hovered] : [];
        const state = school || selected.length ? 'selected' : hovered ? 'hovered' : 'none';
        tl.classList.toggle('focusing', ids.length > 0 || !!school);
        tl.classList.toggle('school-focus', !!school); // the accent switches to the school colour
        labelSpan(school ? data.schoolHL[school] : ids.length === 1 ? personRange(ids[0]) : null);
        if (school) markSchool(school);
        else if (ids.length === 1) markOne(ids[0]);
        else ids.forEach((id, i) => {
          const slot = i < data.maxCompare ? [slots[i]] : []; // beyond that, no colour of their own
          mark(rows[id], 'on', ...slot); mark(mdots[id], 'on', ...slot);
        });
        drawBranches(ids, state, school);
        if (school) showSchool(school);
        else showPanel(selected.length === 1 && !selectMode ? selected[0] : null);
        allBtn.textContent = selected.length === allIds.length ? 'Deselect all' : 'Select all';
      }

      // One person's rows: theirs, anyone alive at the same time (drawBranches marks the
      // rest of the related people), and their school's members, line and founder.
      function markOne(id) {
        const p = data.people[id], b = data.spans[id];
        for (const [o, s] of Object.entries(data.spans)) {
          if (o !== id && s.y1 <= b.y2 && s.y2 >= b.y1) { mark(rows[o], 'rel'); mark(mdots[o], 'rel'); }
        }
        mark(rows[id], 'on'); mark(mdots[id], 'on');
        if (p.school) {
          const s = data.schools[p.school];
          for (const m of s.members) mark(rows[m], 'mate');
          if (s.home) mark(rows[s.home], 'mate');
          if (tags[p.school]) mark(tags[p.school], 'on');
        }
      }

      // A school: its members' rows and its tag.
      function markSchool(id) {
        for (const m of data.schoolHL[id].members) { mark(rows[m], 'rel'); mark(mdots[m], 'rel'); }
        mark(tags[id], 'on');
      }

      // The years at both ends of a span (a person's life, or a school's), beside their branch.
      const spanFrom = document.getElementById('span-from');
      const spanTo = document.getElementById('span-to');
      const personRange = (id) => ({ ...data.spans[id], from: data.people[id].from, to: data.people[id].to, xf: data.branchHL[id].xf });
      function labelSpan(r) {
        spanFrom.hidden = spanTo.hidden = !r;
        if (!r) return;
        const left = `calc(var(--tick-w) + var(--svg-w) * ${r.xf} + 6px)`;
        for (const [el, text, y] of [[spanFrom, r.from, r.y1], [spanTo, r.to, r.y2]]) {
          el.textContent = text; el.style.top = y + 'px'; el.style.left = left;
        }
      }

      // Highlight. Everyone gets a relation to the selected person (worked out at build time)
      // and a lifespan relative to theirs; the profile functions below turn those into a
      // priority and an accent per part. The colours live in the styles.
      const bLine = Object.fromEntries(['life', 'after', 'along', 'influence', 'path'].map((k) => [k, document.getElementById(`bh-${k}`)]));
      const bSlotLines = [...document.querySelectorAll('#branch [data-slot]')];
      const bLeaders = Object.fromEntries([...document.querySelectorAll('#branch .leader')].map((e) => [e.dataset.id, e]));
      const bDots = Object.fromEntries([...document.querySelectorAll('#branch .bd')].map((e) => [e.dataset.id, e]));

      const relationOf = (p, q) => data.branchHL[p].rel[q] ?? 'none';
      // q's lifespan relative to a span (a person's life, or a school's): before, shared or after.
      function lifespanOf(a, q) {
        const b = data.spans[q];
        return b.y2 < a.y1 ? 'before' : b.y1 > a.y2 ? 'after' : 'shared';
      }

      // Inputs: { relation, lifespan, state }. relation is to the selected person, or 'member'
      // when a school is focused. state is 'none' (nobody highlighted), 'hovered'
      // or 'selected'; hovered and selected look the same for now.
      function leaderProfile({ relation, state }) {
        if (state === 'none') return { priority: 'subtle', accent: 'neutral' };
        if (relation === 'self') return { priority: 'normal', accent: 'accent' };
        if (relation !== 'none') return { priority: 'weak', accent: 'neutral' };
        return { priority: 'faint', accent: 'neutral' };
      }
      function dotProfile({ relation, lifespan, state }) {
        if (state === 'none') return { priority: 'max', accent: 'neutral' };
        const empty = relation !== 'self' && lifespan !== 'shared';
        if (relation === 'none') return { priority: 'low', accent: 'neutral', empty };
        if (relation === 'successor') return { priority: 'normal', accent: 'accent', empty };
        return { priority: 'high', accent: 'accent', empty };
      }
      function setLook(el, base, profile) {
        el.setAttribute('class', `${base} p-${profile.priority} a-${profile.accent}${profile.empty ? ' empty' : ''}`);
      }

      function drawBranches(ids, state, school) {
        // One focus (a person or a school) draws its lines; a school has only its path and span.
        const one = school ? data.schoolHL[school] : ids.length === 1 ? data.branchHL[ids[0]] : null;
        const span = school ? data.schoolHL[school] : ids.length === 1 ? data.spans[ids[0]] : null;
        const few = ids.length > 1 && ids.length <= data.maxCompare;
        for (const k in bLine) bLine[k].setAttribute('d', one?.[k] ?? '');
        bSlotLines.forEach((el, i) => el.setAttribute('d', few && ids[i] ? data.branchHL[ids[i]].path : ''));
        for (const q of allIds) {
          if (!one && !ids.length) {
            setLook(bLeaders[q], 'leader', leaderProfile({ state }));
            setLook(bDots[q], 'bd', dotProfile({ state }));
            continue;
          }
          if (one) {
            const relation = school ? (one.members.includes(q) ? 'member' : 'none') : relationOf(ids[0], q);
            const input = { relation, lifespan: lifespanOf(span, q), state };
            setLook(bLeaders[q], 'leader', leaderProfile(input));
            setLook(bDots[q], 'bd', dotProfile(input));
            if (input.relation !== 'none' && input.relation !== 'self') { mark(rows[q], 'rel'); mark(mdots[q], 'rel'); }
            continue;
          }
          // Several people: each one's path in their slot colour (a later slot draws over an earlier one).
          const i = few ? ids.findLastIndex((p) => data.branchHL[p].onPath.includes(q)) : -1;
          const relation = i === -1 ? 'none' : q === ids[i] ? 'self' : 'lineage';
          const slot = i === -1 ? '' : ` ${slots[i]}`;
          setLook(bLeaders[q], 'leader' + slot, leaderProfile({ relation, state }));
          setLook(bDots[q], 'bd' + slot, dotProfile({ relation, lifespan: 'shared', state }));
        }
      }

      const link = (ids) => ids.map((i) => `<a href="#${i}">${data.people[i].name}</a>`).join(', ');
      function showPanel(id) {
        if (!id) { panel.hidden = true; return; }
        const p = data.people[id];
        const s = p.school && data.schools[p.school];
        const lines = [
          s && (s.home === id
            ? `<dt>Founded</dt><dd>${schoolLink(p.school)}${s.founded ? ` (${s.founded})` : ''}<br><small>${s.philosophy}</small></dd>`
            : `<dt>School</dt><dd>${schoolLink(p.school)}<br><small>${s.philosophy}</small></dd>`),
          !p.school && `<dt>School</dt><dd>None</dd>`,
          p.studentOf.length && `<dt>Student of</dt><dd>${link(p.studentOf)}</dd>`,
          p.students.length && `<dt>Teacher of</dt><dd>${link(p.students)}</dd>`,
          p.influence.length && `<dt>Influenced by</dt><dd>${link(p.influence)}</dd>`,
          p.influenced.length && `<dt>Influenced</dt><dd>${link(p.influenced)}</dd>`,
        ].filter(Boolean).join('');
        panel.innerHTML = `<button class="x" aria-label="Close">×</button><h2>${p.name}</h2><div class="dates">${p.span} · active c. ${p.active}</div><p>${p.note}</p><dl>${lines}</dl>`;
        panel.hidden = false;
      }

      const schoolLink = (id) => `<a href="#school:${id}">${data.schools[id].name}</a>`;
      function showSchool(id) {
        const s = data.schools[id], h = data.schoolHL[id];
        const lines = [
          s.home && s.founded && `<dt>Founded</dt><dd>${s.founded} by ${link([s.home])}</dd>`,
          `<dt>Members</dt><dd>${link(h.members)}</dd>`,
        ].filter(Boolean).join('');
        panel.innerHTML = `<button class="x" aria-label="Close">×</button><h2>${s.name}</h2><div class="dates">${h.from} – ${h.to} · ${s.philosophy}</div><p>${s.note}</p><dl>${lines}</dl>`;
        panel.hidden = false;
      }

      // Plain click: select just this one (or clear it). Shift+click or Select mode: add/remove.
      function choose(id, multi) {
        school = null;
        if (!id) selected = [];
        else if (multi) {
          if (selected.includes(id)) selected = selected.filter((s) => s !== id);
          else selected = [...selected, id];
        } else selected = selected.length === 1 && selected[0] === id ? [] : [id];
        render();
      }

      const selectBtn = document.getElementById('select');
      const allBtn = document.getElementById('all');
      allBtn.addEventListener('click', () => {
        selected = selected.length === allIds.length ? [] : [...allIds];
        render();
      });
      function setSelectMode(on) {
        selectMode = on;
        selectBtn.textContent = on ? 'Done' : 'Select';
        selectBtn.setAttribute('aria-pressed', on);
        document.body.classList.toggle('selecting', on);
        allBtn.hidden = !on;
        render();
      }
      selectBtn.addEventListener('click', () => setSelectMode(!selectMode));

      tl.addEventListener('mouseover', (e) => {
        const id = e.target.closest('.row')?.dataset.id ?? null;
        if (id !== hovered) { hovered = id; if (!selected.length && !school) render(); }
      });
      tl.addEventListener('mouseleave', () => { hovered = null; if (!selected.length && !school) render(); });
      tl.addEventListener('click', (e) => {
        const tag = e.target.closest('.btag');
        if (tag) { // focus the school (click again to clear)
          selected = [];
          school = school === tag.dataset.school ? null : tag.dataset.school;
          return render();
        }
        const id = e.target.closest('.row')?.dataset.id ?? null;
        const multi = e.shiftKey || selectMode;
        if (!id && multi) return; // a stray tap shouldn't wipe a comparison
        if (e.shiftKey) getSelection()?.removeAllRanges();
        choose(id, multi);
      });
      panel.addEventListener('click', (e) => {
        if (e.target.closest('.x')) return choose(null);
        const a = e.target.closest('a');
        if (!a) return;
        e.preventDefault();
        const id = a.getAttribute('href').slice(1);
        if (id.startsWith('school:')) { selected = []; school = id.slice(7); return render(); }
        rows[id].scrollIntoView({ behavior: 'smooth', block: 'center' });
        school = null; selected = [id]; render();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (selectMode) setSelectMode(false);
        choose(null);
      });

      // Minimap: viewport box follows scroll; click or drag to jump; click a dot to select.
      let tlTop = 0, tlH = 1, ticking = false;
      const clamp = (v) => Math.max(0, Math.min(1, v));
      function measure() { tlTop = tl.getBoundingClientRect().top + scrollY; tlH = tl.offsetHeight; syncView(); }
      function syncView() {
        ticking = false;
        const a = clamp((scrollY - tlTop) / tlH);
        const b = clamp((scrollY + innerHeight - tlTop) / tlH);
        view.style.top = a * 100 + '%';
        view.style.height = (b - a) * 100 + '%';
      }
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(syncView); } }, { passive: true });
      addEventListener('resize', measure);
      measure();

      const jumpTo = (e) => {
        const r = mini.getBoundingClientRect();
        const f = clamp((e.clientY - r.top) / r.height);
        scrollTo({ top: tlTop + f * tlH - innerHeight / 2 });
      };
      let dragging = false;
      mini.addEventListener('pointerdown', (e) => {
        const dot = e.target.closest('.mdot');
        if (dot) {
          rows[dot.dataset.id].scrollIntoView({ block: 'center' });
          return choose(dot.dataset.id, e.shiftKey || selectMode);
        }
        dragging = true;
        mini.setPointerCapture(e.pointerId);
        jumpTo(e);
      });
      mini.addEventListener('pointermove', (e) => dragging && jumpTo(e));
      mini.addEventListener('pointerup', () => (dragging = false));
      mini.addEventListener('pointercancel', () => (dragging = false));
    </script>

    <style is:global>
      :root {
        /* Colour meanings: --accent (blue) philosophers and philosophy, --lifespan (green) life,
           --school (ochre yellow) establishments. Everything else is neutral. */
        --fg: #1d1d1b; --muted: #7a776f; --faint: #e4e0d7; --bg: #faf9f6; --accent: #2f5d8a; --lifespan: #3d8a5f; --school: #b5850f;
        --tick-w: 64px; --svg-w: 260px;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.35 ui-serif, Georgia, serif; }
      header { max-width: 1000px; margin: 0 auto; padding: 32px 16px 24px; }
      h1 { font-size: 28px; margin: 0 0 8px; font-weight: 600; }
      .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); font: 13px system-ui, sans-serif; margin: 0; align-items: center; }
      .legend svg { vertical-align: middle; margin-right: 5px; }
      .k-branch { stroke: color-mix(in oklch, var(--fg) var(--w-low), var(--bg)); stroke-width: 2; }
      .k-merge { stroke: color-mix(in oklch, var(--fg) var(--w-low), var(--bg)); stroke-width: 1.4; stroke-dasharray: 4 3; }
      .k-life { stroke: color-mix(in oklch, var(--lifespan) var(--w-low), var(--bg)); stroke-width: 7; }

      /* Era labels sit just right of the graph's first column. */
      #tl { --graph-left: calc(var(--tick-w) + var(--svg-w) * var(--graph-f) + 6px); }
      #tl { position: relative; max-width: 1000px; margin: 0 auto 120px; }

      .tick, .era { position: absolute; left: 0; right: 0; height: 0; pointer-events: none; }
      .tick { border-top: 1px solid #efece5; }
      .tick span { position: absolute; left: 16px; top: -8px; font: 11px system-ui, sans-serif; color: var(--muted); background: var(--bg); padding-right: 4px; }
      .era { z-index: 1; /* above the graph lines, below the year labels and panels */ border-top: 1px solid #c8d5e2; width: calc(var(--tick-w) + var(--svg-w)); }
      .era span { position: absolute; left: var(--graph-left); top: 0; padding-top: 2px; /* flush under the rule, so no line shows through */ font: 600 10px system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); background: var(--bg); padding-right: 4px; white-space: nowrap; }

      #lines { position: absolute; top: 0; left: var(--tick-w); width: var(--svg-w); height: 100%; overflow: visible; pointer-events: none; }
      #lines path { fill: none; vector-effect: non-scaling-stroke; }

      /* Priority × accent: the accent mixed into the background by the priority's
         golden-ratio colour weight (φ⁻⁵ … 1). Mixing against --bg keeps it right in dark mode. */
      :root { --w-faint: 9.017%; --w-subtle: 14.59%; --w-weak: 23.607%; --w-low: 38.197%; --w-normal: 61.803%; --w-high: 76.393%; --w-max: 100%; }
      .p-faint { --w: var(--w-faint); } .p-subtle { --w: var(--w-subtle); } .p-weak { --w: var(--w-weak); } .p-low { --w: var(--w-low); }
      .p-normal { --w: var(--w-normal); } .p-high { --w: var(--w-high); } .p-max { --w: var(--w-max); }
      .a-neutral { --hue: var(--fg); }
      .a-accent { --hue: var(--c, var(--accent)); } /* --c: a compare slot's colour */
      .school-focus { --c: var(--school); --lifespan: var(--school); } /* a focused school: its own accent, an ochre yellow, for its span too */
      .a-lifespan { --hue: var(--lifespan); } /* time alive, as opposed to lineage: a cool green, so it sits behind the blue */
      .p-faint, .p-subtle, .p-weak, .p-low, .p-normal, .p-high, .p-max { --tone: color-mix(in oklch, var(--hue) var(--w), var(--bg)); }

      /* Branch view graph lines: neutral low, influences neutral weak (dashed); both drop to faint
         while someone is highlighted. Leaders and dots get their looks from the profile functions. */
      #branch .branch { stroke: color-mix(in oklch, var(--fg) var(--w-low), var(--bg)); stroke-width: 2; }
      #branch .merge { stroke: color-mix(in oklch, var(--fg) var(--w-weak), var(--bg)); stroke-width: 1.2; stroke-dasharray: 4 3; }
      .focusing #branch :is(.branch, .merge) { stroke: color-mix(in oklch, var(--fg) var(--w-faint), var(--bg)); }
      #branch .leader { stroke: var(--tone); stroke-width: 1; }
      #branch .gl { stroke: var(--tone); }
      #branch .trail { stroke-width: 2.5; }
      #branch .after { stroke-width: 2; }
      #branch .along { stroke-width: 1.5; }
      #branch .infl { stroke-width: 1.5; stroke-dasharray: 4 3; }
      #branch .life { stroke-width: 7; stroke-linecap: round; }
      #branch .bdot { stroke: var(--tone); stroke-width: 6; stroke-linecap: round; }
      #branch .hole { display: none; stroke: var(--bg); stroke-width: 3; stroke-linecap: round; }
      #branch .bd.empty .hole { display: inline; }

      /* Compare colours, one per selected person (slot order). */
      .s0 { --c: #2f5d8a; } .s1 { --c: #b5562c; } .s2 { --c: #3f7d4e; } .s3 { --c: #7a4a8c; } .s4 { --c: #b08a1e; }

      .row { position: absolute; left: calc(var(--tick-w) + var(--svg-w)); right: 16px; padding-left: 14px; cursor: pointer; }
      .dot { position: absolute; left: -5px; top: 7px; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--fg); }
      .note { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      /* The name on one line, cut off with … when too long. */
      .l1 { display: flex; align-items: center; white-space: nowrap; }
      .l1 b { font-size: 16px; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
      /* Three tiers: grand (Socrates, Plato, Aristotle) larger, main figures as is, everyone else at 0.85 in regular weight. */
      .row.grand .l1 b { font-size: 18px; }
      .row.grand .dot { width: 12px; height: 12px; left: -6px; top: 6px; }
      .row.minor .l1 b { font-size: 13.6px; font-weight: 400; }
      .row.minor .note { font-size: 10.6px; }
      .row.minor .dot { width: 8px; height: 8px; left: -4px; top: 8px; } /* whole pixels keep it round */
      .dates, .note { font: 12.5px system-ui, sans-serif; color: var(--muted); }
      .spanlabel { position: absolute; transform: translateY(-50%); font: 600 11px system-ui, sans-serif; color: color-mix(in oklch, var(--lifespan) var(--w-high), var(--bg)); background: var(--bg); padding: 0 3px; white-space: nowrap; pointer-events: none; z-index: 1; }

      .focusing .row { opacity: .3; }
      .focusing .row.mate { opacity: .6; }
      .focusing .row.rel { opacity: 1; }
      .focusing .row.on { opacity: 1; }
      .row.on .dot { border-color: var(--c, var(--accent)); background: var(--c, var(--accent)); }
      .row.on[class*=" s"] b { color: var(--c); }
      /* School tags, like branch names in a git graph: one column just before the names, on the founder's row. */
      .btag { position: absolute; left: calc(var(--tick-w) + var(--svg-w) * var(--xf) + 2px); transform: translateY(-50%);
        max-width: calc(var(--svg-w) * (1 - var(--xf)) - 10px); overflow: hidden; text-overflow: ellipsis;
        font: 600 10px/14px system-ui, sans-serif; color: color-mix(in oklch, var(--fg) var(--w-normal), var(--bg));
        background: var(--bg); border: 1px solid color-mix(in oklch, var(--fg) var(--w-weak), var(--bg)); border-radius: 3px;
        padding: 0 5px; white-space: nowrap; cursor: pointer; z-index: 2; }
      .btag:hover { border-color: color-mix(in oklch, var(--accent) var(--w-normal), var(--bg)); }
      .focusing .btag { color: color-mix(in oklch, var(--fg) var(--w-low), var(--bg)); border-color: color-mix(in oklch, var(--fg) var(--w-subtle), var(--bg)); }
      .focusing .btag.on { color: color-mix(in oklch, var(--c, var(--accent)) var(--w-high), var(--bg)); border-color: color-mix(in oklch, var(--c, var(--accent)) var(--w-normal), var(--bg)); }

      #panel { position: fixed; right: 16px; bottom: 16px; width: 300px; max-height: 70vh; overflow: auto; background: #fff; border: 1px solid var(--faint); box-shadow: 0 6px 24px rgba(0,0,0,.08); padding: 14px 16px; font: 13px/1.45 system-ui, sans-serif; z-index: 10; }
      #panel h2 { font: 600 19px ui-serif, Georgia, serif; margin: 0; }
      #panel p { margin: 6px 0 10px; }
      #panel dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; }
      #panel dt { color: var(--muted); }
      #panel dd { margin: 0; }
      #panel small { color: var(--muted); }
      #panel a { color: var(--accent); text-decoration: none; }
      #panel .x { position: absolute; top: 6px; right: 8px; border: 0; background: none; font-size: 20px; color: var(--muted); cursor: pointer; }

      #tools { position: fixed; top: 12px; right: 12px; z-index: 11; display: flex; gap: 6px; }
      #tools button { font: 600 13px system-ui, sans-serif; color: var(--accent); background: #fff; border: 1px solid var(--faint); border-radius: 999px; padding: 6px 14px; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
      #tools [aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
      .selecting .row:not(.on) .dot { border-style: dashed; }

      #mini { position: fixed; top: 16px; bottom: 16px; left: 12px; width: 48px; background: #f3f1ec; border: 1px solid var(--faint); border-radius: 4px; cursor: pointer; touch-action: none; user-select: none; z-index: 5; }
      .band { position: absolute; left: 0; right: 0; border-top: 1px solid #c8d5e2; }
      .band:nth-of-type(even) { background: #eae7df; }
      .band span { position: absolute; left: 1px; top: 4px; writing-mode: vertical-rl; font: 600 8.5px system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); white-space: nowrap; pointer-events: none; }
      .mdot { position: absolute; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: #8f8b81; }
      .mdot.rel { background: var(--accent); opacity: .55; }
      .mdot.on { background: var(--c, var(--accent)); width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; z-index: 1; }
      #view { position: absolute; left: -1px; right: -1px; border: 1.5px solid var(--accent); background: rgba(47, 93, 138, .08); border-radius: 3px; pointer-events: none; }
      @media (max-width: 1160px) { body { padding-left: 64px; } }

      @media (max-width: 700px) {
        body { padding-left: 30px; }
        #mini { left: 4px; width: 24px; top: 8px; bottom: 8px; }
        .band span { display: none; }
        .mdot { left: 4px !important; }
        :root { --tick-w: 0px; --svg-w: 110px; }
        .btag { display: none; } /* no room for the tag column on a phone; the info card names the school */
        header { padding: 20px 14px 16px; }
        .tick span { left: 2px; font-size: 9.5px; }
        .era span { font-size: 9.5px; }
        .row { right: 8px; }
        .l1 { white-space: normal; line-height: 1.15; }
        .note { display: none; }
        #panel { left: 34px; right: 8px; bottom: 8px; width: auto; max-height: 45vh; }
      }
    </style>
  </body>
</html>
