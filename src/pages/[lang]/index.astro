---
// One page per translated language: /he/, /fr/ … (English is at /).
import Timeline from '../../components/Timeline.astro';
import { available } from '../../i18n';

export function getStaticPaths() {
  return available.filter((l) => l.code !== 'en').map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---

<Timeline lang={lang!} />
